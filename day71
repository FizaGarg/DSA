#include <stdio.h>

#define EMPTY -1
#define MAX 100

int table[MAX];
int m;

// hash function
int hash(int key) {
    return key % m;
}

// insert using quadratic probing
void insert(int key) {
    int index = hash(key);

    if(table[index] == EMPTY) {
        table[index] = key;
        return;
    }

    // collision → quadratic probing
    for(int i = 1; i < m; i++) {
        int newIndex = (index + i*i) % m;

        if(table[newIndex] == EMPTY) {
            table[newIndex] = key;
            return;
        }
    }

    printf("Hash Table Full\n");
}

// search using quadratic probing
int search(int key) {
    int index = hash(key);

    if(table[index] == key)
        return 1;

    for(int i = 1; i < m; i++) {
        int newIndex = (index + i*i) % m;

        if(table[newIndex] == EMPTY)
            return 0;

        if(table[newIndex] == key)
            return 1;
    }

    return 0;
}

int main() {
    int q;
    char op[10];
    int key;

    // input table size
    scanf("%d", &m);

    // initialize table
    for(int i = 0; i < m; i++) {
        table[i] = EMPTY;
    }

    // number of operations
    scanf("%d", &q);

    while(q--) {
        scanf("%s %d", op, &key);

        if(op[0] == 'I') { // INSERT
            insert(key);
        }
        else if(op[0] == 'S') { // SEARCH
            if(search(key))
                printf("FOUND\n");
            else
                printf("NOT FOUND\n");
        }
    }

    return 0;
}
