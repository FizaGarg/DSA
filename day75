#include <stdio.h>

#define MAX 1000

int main() {
    int arr[] = {15, -2, 2, -8, 1, 7, 10, 23};
    int n = 8;

    int sum = 0, maxLen = 0;

    // store prefix sums and first index
    int prefix[MAX];
    int index[MAX];

    int size = 0;

    for(int i = 0; i < n; i++) {
        sum += arr[i];

        // case 1: sum becomes 0
        if(sum == 0) {
            maxLen = i + 1;
        }

        // check if sum seen before
        int found = 0;
        for(int j = 0; j < size; j++) {
            if(prefix[j] == sum) {
                int len = i - index[j];
                if(len > maxLen)
                    maxLen = len;
                found = 1;
                break;
            }
        }

        // if not found, store it
        if(!found) {
            prefix[size] = sum;
            index[size] = i;
            size++;
        }
    }

    printf("%d", maxLen);

    return 0;
}
