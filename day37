#include <stdio.h>

#define SIZE 100

int pq[SIZE];
int n = 0;

// Insert
void insert(int x) {
    if(n == SIZE) return;
    
    int i = n - 1;
    
    // Shift elements to maintain sorted order
    while(i >= 0 && pq[i] > x) {
        pq[i + 1] = pq[i];
        i--;
    }
    
    pq[i + 1] = x;
    n++;
}

// Delete (remove smallest)
int delete() {
    if(n == 0) return -1;
    
    int val = pq[0];
    
    for(int i = 1; i < n; i++) {
        pq[i - 1] = pq[i];
    }
    
    n--;
    return val;
}

// Peek (smallest element)
int peek() {
    if(n == 0) return -1;
    return pq[0];
}

int main() {
    int N, x;
    char op[10];

    scanf("%d", &N);

    for(int i = 0; i < N; i++) {
        scanf("%s", op);

        if(op[0] == 'i') { // insert
            scanf("%d", &x);
            insert(x);
        }
        else if(op[0] == 'd') { // delete
            printf("%d\n", delete());
        }
        else if(op[0] == 'p') { // peek
            printf("%d\n", peek());
        }
    }

    return 0;
}
