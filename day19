#include <stdio.h>
#include <stdlib.h>

int cmp(const void *a, const void *b) {
    return *(int*)a - *(int*)b;
}

int main() {
    int n;
    scanf("%d", &n);
    int a[n];

    for(int i = 0; i < n; i++) scanf("%d", &a[i]);

    qsort(a, n, sizeof(int), cmp);

    int l = 0, r = n - 1;
    int x = a[0], y = a[n-1];

    while(l < r) {
        int sum = a[l] + a[r];

        if(abs(sum) < abs(x + y)) {
            x = a[l];
            y = a[r];
        }

        if(sum < 0) l++;
        else r--;
    }

    printf("%d %d", x, y);
    return 0;
}
