#include <stdio.h>

int main() {
    int n, k, a[100];
    int found = 0, comp = 0;

 
    scanf("%d", &n);

  
    for(int i = 0; i < n; i++) {
        scanf("%d", &a[i]);
    }
   
    scanf("%d", &k);

    for(int i = 0; i < n; i++) {
        comp++;            
        if(a[i] == k) {
            printf("Found at index %d\n", i);
            found = 1;
            break;
        }
    }

    if(found == 0) {
        printf("Not Found\n");
    }

    printf("Comparisons = %d", comp);

    return 0;
}
