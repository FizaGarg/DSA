#include <stdio.h>
#include <stdlib.h>

struct Node {
    int data;
    struct Node* next;
};

// Create list
struct Node* createList(int n) {
    struct Node *head = NULL, *temp = NULL, *newNode;

    for(int i = 0; i < n; i++) {
        newNode = (struct Node*)malloc(sizeof(struct Node));
        scanf("%d", &newNode->data);
        newNode->next = NULL;

        if(head == NULL) {
            head = temp = newNode;
        } else {
            temp->next = newNode;
            temp = newNode;
        }
    }
    return head;
}

// Get length
int getLength(struct Node* head) {
    int len = 0;
    while(head != NULL) {
        len++;
        head = head->next;
    }
    return len;
}

// Find intersection
int findIntersection(struct Node* l1, struct Node* l2) {
    int len1 = getLength(l1);
    int len2 = getLength(l2);

    int diff = abs(len1 - len2);

    // Move longer list ahead
    if(len1 > len2) {
        for(int i = 0; i < diff; i++) l1 = l1->next;
    } else {
        for(int i = 0; i < diff; i++) l2 = l2->next;
    }

    // Traverse together
    while(l1 != NULL && l2 != NULL) {
        if(l1->data == l2->data)
            return l1->data;

        l1 = l1->next;
        l2 = l2->next;
    }

    return -1; // no intersection
}

int main() {
    int n, m;

    scanf("%d", &n);
    struct Node* list1 = createList(n);

    scanf("%d", &m);
    struct Node* list2 = createList(m);

    int res = findIntersection(list1, list2);

    if(res == -1)
        printf("No Intersection");
    else
        printf("%d", res);

    return 0;
}
