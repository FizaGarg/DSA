#include <stdio.h>

#define INF 9999

int main() {
    int n, m;
    scanf("%d %d", &n, &m);

    int g[10][10];

    // initialize
    for(int i = 1; i <= n; i++)
        for(int j = 1; j <= n; j++)
            g[i][j] = INF;

    // input edges
    for(int i = 0; i < m; i++) {
        int u, v, w;
        scanf("%d %d %d", &u, &v, &w);
        g[u][v] = g[v][u] = w;
    }

    int visited[10] = {0};
    visited[1] = 1;

    int total = 0;

    for(int k = 1; k < n; k++) {
        int min = INF, x, y;

        for(int i = 1; i <= n; i++) {
            if(visited[i]) {
                for(int j = 1; j <= n; j++) {
                    if(!visited[j] && g[i][j] < min) {
                        min = g[i][j];
                        x = i;
                        y = j;
                    }
                }
            }
        }

        visited[y] = 1;
        total += min;
    }

    printf("%d", total);

    return 0;
}
