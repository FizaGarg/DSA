#include <stdio.h>
#include <string.h>

int main() {
    char s[100];
    int count[26] = {0};  // for 'a' to 'z'

    scanf("%s", s);

    // Step 1: count frequency
    for(int i = 0; s[i] != '\0'; i++) {
        count[s[i] - 'a']++;
    }

    // Step 2: find first non-repeating
    for(int i = 0; s[i] != '\0'; i++) {
        if(count[s[i] - 'a'] == 1) {
            printf("%c", s[i]);
            return 0;
        }
    }

    // If all repeat
    printf("$");

    return 0;
}
