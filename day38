#include <stdio.h>

#define SIZE 100

int dq[SIZE];
int front = -1, rear = -1;

// Check empty
int empty() {
    return (front == -1);
}

// Size
int size() {
    if(empty()) return 0;
    if(rear >= front) return rear - front + 1;
    return SIZE - front + rear + 1;
}

// Push Front
void push_front(int x) {
    if((front == 0 && rear == SIZE-1) || (front == rear+1)) {
        printf("Overflow\n");
        return;
    }
    if(front == -1) front = rear = 0;
    else if(front == 0) front = SIZE - 1;
    else front--;

    dq[front] = x;
}

// Push Back
void push_back(int x) {
    if((front == 0 && rear == SIZE-1) || (front == rear+1)) {
        printf("Overflow\n");
        return;
    }
    if(front == -1) front = rear = 0;
    else if(rear == SIZE - 1) rear = 0;
    else rear++;

    dq[rear] = x;
}

// Pop Front
void pop_front() {
    if(empty()) {
        printf("Underflow\n");
        return;
    }
    if(front == rear) front = rear = -1;
    else if(front == SIZE - 1) front = 0;
    else front++;
}

// Pop Back
void pop_back() {
    if(empty()) {
        printf("Underflow\n");
        return;
    }
    if(front == rear) front = rear = -1;
    else if(rear == 0) rear = SIZE - 1;
    else rear--;
}

// Front element
int get_front() {
    if(empty()) return -1;
    return dq[front];
}

// Rear element
int get_back() {
    if(empty()) return -1;
    return dq[rear];
}

// Display deque
void display() {
    if(empty()) return;

    int i = front;
    while(1) {
        printf("%d ", dq[i]);
        if(i == rear) break;
        i = (i + 1) % SIZE;
    }
}

int main() {
    // Example usage
    push_back(10);
    push_back(20);
    push_front(5);
    push_back(30);

    printf("Deque: ");
    display();

    printf("\nFront: %d", get_front());
    printf("\nBack: %d", get_back());
    printf("\nSize: %d\n", size());

    pop_front();
    pop_back();

    printf("After deletion: ");
    display();

    return 0;
}
