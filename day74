#include <stdio.h>
#include <string.h>

int main() {
    int n;
    scanf("%d", &n);

    char names[n][50];

    // input names
    for(int i = 0; i < n; i++) {
        scanf("%s", names[i]);
    }

    char winner[50];
    int maxCount = 0;

    // check each name
    for(int i = 0; i < n; i++) {
        int count = 0;

        // count occurrences
        for(int j = 0; j < n; j++) {
            if(strcmp(names[i], names[j]) == 0) {
                count++;
            }
        }

        // update winner
        if(count > maxCount) {
            maxCount = count;
            strcpy(winner, names[i]);
        }
        else if(count == maxCount) {
            if(strcmp(names[i], winner) < 0) {
                strcpy(winner, names[i]);
            }
        }
    }

    printf("%s %d", winner, maxCount);

    return 0;
}
