#include <stdio.h>
#define INF 9999

int main() {
    int n, d[10][10];
    scanf("%d",&n);

    // input
    for(int i=0;i<n;i++){
        for(int j=0;j<n;j++){
            scanf("%d",&d[i][j]);
            if(d[i][j]==-1 && i!=j)
                d[i][j]=INF;
        }
    }

    // Floyd-Warshall
    for(int k=0;k<n;k++)
        for(int i=0;i<n;i++)
            for(int j=0;j<n;j++)
                if(d[i][k]+d[k][j] < d[i][j])
                    d[i][j] = d[i][k] + d[k][j];

    // output
    for(int i=0;i<n;i++){
        for(int j=0;j<n;j++){
            if(d[i][j]==INF) printf("-1 ");
            else printf("%d ",d[i][j]);
        }
        printf("\n");
    }

    return 0;
}
