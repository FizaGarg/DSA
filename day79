#include <stdio.h>
#define INF 9999

int main() {
    int n, m, g[10][10], dist[10], vis[10]={0};

    scanf("%d %d",&n,&m);

    // init
    for(int i=1;i<=n;i++)
        for(int j=1;j<=n;j++)
            g[i][j]=INF;

    // edges
    for(int i=0;i<m;i++){
        int u,v,w;
        scanf("%d %d %d",&u,&v,&w);
        g[u][v]=g[v][u]=w;
    }

    int s;
    scanf("%d",&s);

    // init dist
    for(int i=1;i<=n;i++) dist[i]=INF;
    dist[s]=0;

    // dijkstra
    for(int k=1;k<=n;k++){
        int min=INF,u;

        for(int i=1;i<=n;i++)
            if(!vis[i] && dist[i]<min)
                min=dist[i], u=i;

        vis[u]=1;

        for(int v=1;v<=n;v++)
            if(!vis[v] && dist[u]+g[u][v]<dist[v])
                dist[v]=dist[u]+g[u][v];
    }

    for(int i=1;i<=n;i++)
        printf("%d ",dist[i]);

    return 0;
}
