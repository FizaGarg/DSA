#include <stdio.h>
#include <stdlib.h>

#define MAX 100

struct Node {
    int data;
    struct Node *left, *right;
};

// Queue for level order with horizontal distance
struct QNode {
    struct Node* node;
    int hd;
};

struct Node* newNode(int val) {
    struct Node* temp = (struct Node*)malloc(sizeof(struct Node));
    temp->data = val;
    temp->left = temp->right = NULL;
    return temp;
}

// Build tree
struct Node* buildTree(int arr[], int n) {
    struct Node* nodes[n];

    for(int i = 0; i < n; i++) {
        if(arr[i] != -1)
            nodes[i] = newNode(arr[i]);
        else
            nodes[i] = NULL;
    }

    for(int i = 0; i < n; i++) {
        if(nodes[i] != NULL) {
            int l = 2*i + 1, r = 2*i + 2;
            if(l < n) nodes[i]->left = nodes[l];
            if(r < n) nodes[i]->right = nodes[r];
        }
    }

    return nodes[0];
}

int main() {
    int n;
    scanf("%d", &n);

    int arr[n];
    for(int i = 0; i < n; i++)
        scanf("%d", &arr[i]);

    struct Node* root = buildTree(arr, n);

    // Map using array (hd range: -100 to +100)
    int vertical[2*MAX][MAX], count[2*MAX] = {0};

    struct QNode q[MAX];
    int front = 0, rear = 0;

    // Start from root (hd = 0)
    q[rear++] = (struct QNode){root, MAX};

    while(front < rear) {
        struct QNode temp = q[front++];
        struct Node* curr = temp.node;
        int hd = temp.hd;

        if(curr == NULL) continue;

        vertical[hd][count[hd]++] = curr->data;

        if(curr->left)
            q[rear++] = (struct QNode){curr->left, hd - 1};

        if(curr->right)
            q[rear++] = (struct QNode){curr->right, hd + 1};
    }

    // Print result
    for(int i = 0; i < 2*MAX; i++) {
        if(count[i] > 0) {
            for(int j = 0; j < count[i]; j++)
                printf("%d ", vertical[i][j]);
            printf("\n");
        }
    }

    return 0;
}
