#include <stdio.h>

#define MAX 1000

int adj[MAX][MAX];   // adjacency list (array form)
int size[MAX];       // number of neighbors for each vertex
int visited[MAX];

// DFS to detect cycle
int dfs(int v, int parent) {
    visited[v] = 1;

    for(int i = 0; i < size[v]; i++) {
        int u = adj[v][i];

        if(!visited[u]) {
            if(dfs(u, v))
                return 1;
        }
        else if(u != parent) {
            return 1; // cycle found
        }
    }
    return 0;
}

int main() {
    int n, m;
    scanf("%d %d", &n, &m);

    // Initialize
    for(int i = 0; i < n; i++) {
        size[i] = 0;
        visited[i] = 0;
    }

    // Input edges
    for(int i = 0; i < m; i++) {
        int u, v;
        scanf("%d %d", &u, &v);

        // Undirected graph
        adj[u][size[u]++] = v;
        adj[v][size[v]++] = u;
    }

    // Check all components
    for(int i = 0; i < n; i++) {
        if(!visited[i]) {
            if(dfs(i, -1)) {
                printf("YES\n");
                return 0;
            }
        }
    }

    printf("NO\n");
    return 0;
}
