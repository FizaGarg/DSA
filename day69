#include <stdio.h>
#include <limits.h>
#include <stdbool.h>

#define MAX 100

int adj[MAX][MAX];
int dist[MAX];
bool visited[MAX];
int n;

// function to find node with minimum distance
int getMin() {
    int min = INT_MAX, index = -1;

    for(int i = 0; i < n; i++) {
        if(!visited[i] && dist[i] < min) {
            min = dist[i];
            index = i;
        }
    }
    return index;
}

// Dijkstra function
void dijkstra(int src) {
    // initialize
    for(int i = 0; i < n; i++) {
        dist[i] = INT_MAX;
        visited[i] = false;
    }

    dist[src] = 0;

    for(int count = 0; count < n - 1; count++) {
        int u = getMin(); // acts like priority queue
        visited[u] = true;

        for(int v = 0; v < n; v++) {
            if(!visited[v] && adj[u][v] && dist[u] != INT_MAX &&
               dist[u] + adj[u][v] < dist[v]) {
                dist[v] = dist[u] + adj[u][v];
            }
        }
    }

    // print result
    printf("Vertex\tDistance from Source\n");
    for(int i = 0; i < n; i++) {
        printf("%d\t%d\n", i, dist[i]);
    }
}

int main() {
    int src;

    printf("Enter number of vertices: ");
    scanf("%d", &n);

    printf("Enter adjacency matrix (0 if no edge):\n");
    for(int i = 0; i < n; i++) {
        for(int j = 0; j < n; j++) {
            scanf("%d", &adj[i][j]);
        }
    }

    printf("Enter source vertex: ");
    scanf("%d", &src);

    dijkstra(src);

    return 0;
}
